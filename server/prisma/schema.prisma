generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
  @@index([name])
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(160)
  email       String?  @unique @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]
  stockMovements StockMovement[]
  inventoryBatches InventoryBatch[]
  transactions VendorTransaction[]

  @@map("vendors")
  @@index([name])
  @@index([email])
}

model InventoryBatch {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  vendorId     String?  @map("vendor_id") @db.Uuid
  quantity     Int      @default(0)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  batchDate    DateTime @map("batch_date") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  stockMovements StockMovement[]

  @@map("inventory_batches")
  @@index([productId])
  @@index([vendorId])
  @@index([batchDate(sort: Desc)])
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  vendorId     String?  @map("vendor_id") @db.Uuid
  sku          String   @unique @db.VarChar(60)
  name         String   @db.VarChar(160)
  description  String?  @db.Text
  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  currentStock Int      @default(0) @map("current_stock")
  reorderLevel Int      @default(0) @map("reorder_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendor           Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  stockMovements   StockMovement[]
  inventoryBatches InventoryBatch[]

  @@map("products")
  @@index([categoryId])
  @@index([vendorId])
  @@index([name])
  @@index([currentStock])
}

model StockMovement {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  batchId      String?  @map("batch_id") @db.Uuid
  vendorId     String?  @map("vendor_id") @db.Uuid
  movementType String   @map("movement_type") @db.VarChar(10)
  quantity     Int
  unitPrice    Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalAmount  Decimal? @map("total_amount") @db.Decimal(12, 2)
  reason       String   @db.VarChar(120)
  reference    String?  @db.VarChar(120)
  notes        String?  @db.Text
  movementDate DateTime @default(now()) @map("movement_date") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  batch   InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vendor  Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("stock_movements")
  @@index([productId])
  @@index([batchId])
  @@index([vendorId])
  @@index([movementType])
  @@index([movementDate(sort: Desc)])
  @@index([reference])
}

model VendorTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  transactionType String  @map("transaction_type") @db.VarChar(10) // 'IN' for purchase, 'OUT' for payment
  amount        Decimal  @db.Decimal(12, 2)
  description   String?  @db.VarChar(255)
  notes         String?  @db.Text
  referenceNo   String?  @map("reference_no") @db.VarChar(120)
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("vendor_transactions")
  @@index([vendorId])
  @@index([transactionType])
  @@index([transactionDate(sort: Desc)])
}
